package view

import "github.com/atvirokodosprendimai/app-warehousev1/internal/core"

// Every component in this file is a MORPH TARGET: it carries a stable id and is
// sent on its own over SSE to replace what is already on the page. They are
// defined once and used both by the initial page render and by the patch, so a
// fragment can never drift from the page it lives in — which is the failure that
// happens the moment a handler builds HTML a template does not also build.

// InboxBanner is the live "you have submissions waiting" strip.
//
// It sits above everything, on every page, on every screen size — because its
// job is to reach an administrator who is looking at something else. It is
// pushed down the page's SSE stream the moment a submission arrives, so nobody
// has to reload to find out.
//
// The wrapper is ALWAYS rendered, even at zero, because it is the morph target:
// a fragment can only replace an element that is already there, so a banner that
// only existed when there was something to say could never appear.
//
// role="status" makes it a polite live region, so a screen reader announces the
// change instead of it being a purely visual event.
templ InboxBanner(open int) {
	<div id="inbox-banner">
		if open > 0 {
			<a class="inbox-banner" href="/inbox" role="status">
				<span class="inbox-dot" aria-hidden="true"></span>
				<span>
					<strong>{ itoa(open) }</strong>
					if open == 1 {
						new submission waiting for a decision
					} else {
						new submissions waiting for a decision
					}
				</span>
				<span class="inbox-go" aria-hidden="true">Open inbox →</span>
			</a>
		}
	</div>
}

// NewOfferAction is the top-bar button that creates an offer.
//
// It POSTS rather than navigating (ADR-020). There is no intake screen left to
// navigate to: every question that screen asked was already optional — the title
// since ADR-019, the reference because ADR-010 gives the database that job, and
// the location because the editor has its own card for it — so it stood between
// a person holding an object and the camera while collecting nothing.
templ NewOfferAction() {
	<button
		class="btn btn-primary"
		type="button"
		data-on:click="@post('/offers')"
		data-indicator:_busy
		data-attr:disabled="$_busy"
	>
		<span data-show="$_busy" style="display:none" class="spinner" aria-hidden="true"></span>
		<span>New offer</span>
	</button>
}

// AuthMessage is the sign-in screen's message slot.
templ AuthMessage(text string) {
	<div id="auth-msg">
		if text != "" {
			@Message("error", text)
		}
	</div>
}

// Flash is a message slot addressed by id, for screens that have one place to
// report what just happened.
//
// Sending it with an empty text CLEARS the slot, which is how a successful
// action removes the error left by the previous attempt. A handler that only
// ever patched on failure would leave a stale error above a form that has since
// worked.
templ Flash(id, kind, text string) {
	<div id={ id }>
		if text != "" {
			@Message(kind, text)
		}
	</div>
}

// UserTable is the accounts list.
templ UserTable(users []core.User) {
	<div id="user-table" class="table-wrap">
		<table>
			<thead>
				<tr>
					<th scope="col">Name</th>
					<th scope="col">Email</th>
					<th scope="col">Role</th>
					<th scope="col">State</th>
				</tr>
			</thead>
			<tbody>
				for _, m := range users {
					<tr>
						<td>{ m.Name() }</td>
						<td class="code">{ m.Email }</td>
						<td class="muted">
							if m.IsAdmin {
								Administrator
							} else {
								Staff
							}
						</td>
						<td>
							if m.Active() {
								<span class="badge badge-listed">Active</span>
							} else {
								<span class="badge badge-archived">Disabled</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
