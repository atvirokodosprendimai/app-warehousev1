package view

import (
	"time"

	"github.com/atvirokodosprendimai/app-warehousev1/internal/core"
)

// SettingsView is the deployment-settings screen.
type SettingsView struct {
	Page Page
	// Current is the origin photo addresses are ACTUALLY built from right now,
	// whatever its source. It is the question an operator is really asking.
	Current string
	// FromEnvironment is the start-up default, shown so it is obvious whether the
	// stored value is doing anything or the deployment is still on its default.
	FromEnvironment string
	// Stored is the saved override, empty when none has been set.
	Stored string
	// UpdatedAt is when it was saved.
	UpdatedAt time.Time
	// Reachable reports whether the current origin could be fetched from outside
	// this machine. False is a warning, never a refusal.
	Reachable bool
	// Note is a message to show after a save.
	Note string
	// EbayStored is what has been saved for eBay, field by field. An empty field
	// means "fall back to the start-up default", exactly as PublicBaseURL does.
	EbayStored core.Marketplace
	// EbayFromEnv is the start-up default, shown so it is obvious which fields
	// the stored values are actually overriding.
	EbayFromEnv core.Marketplace
	// EbayEffective is what an export will actually use — the resolution of the
	// two above, computed with the SAME rule the exporter uses.
	EbayEffective core.Marketplace
}

// Source describes where the effective value came from, in one phrase.
func (s SettingsView) Source() string {
	if s.Stored != "" && s.Stored == s.Current {
		return "set here"
	}
	return "from the environment at start-up"
}

// SettingsScreen is the whole page.
templ SettingsScreen(s SettingsView) {
	<div class="stack" data-signals={ settingsSignals(s) }>
		<div id="settings-msg"></div>
		@SettingsPanel(s)
	</div>
}

// settingsBoxValue is what the input starts with.
//
// The EFFECTIVE value, not the stored one: on a fresh installation the stored
// value is empty and the box would be blank over a working deployment, which
// reads as "nothing is configured" when something is. Pre-filling with what is
// actually in use also makes the commonest edit — correcting a domain — a change
// rather than a retype.
func settingsBoxValue(s SettingsView) string {
	if s.Stored != "" {
		return s.Stored
	}
	return s.Current
}

// settingsSignals is the whole screen's initial signal state.
//
// Every box starts on the EFFECTIVE value rather than the stored one, for the
// same reason the domain box does: a blank field over a working configuration
// reads as "nothing is set" when something is, and pre-filling makes the
// commonest edit a change rather than a retype.
//
// ⚠ All four ride to the backend on every action, because none is underscore
// prefixed — which is deliberate here. PostSettings performs a whole-struct
// save, so a signal that did not arrive would be saved as empty.
func settingsSignals(s SettingsView) string {
	return "{" +
		"setPublicBase: " + jsString(settingsBoxValue(s)) + ", " +
		"setEbayCategory: " + jsString(s.EbayEffective.Category) + ", " +
		"setEbayCondition: " + jsString(s.EbayEffective.ConditionID) + ", " +
		"setEbayLocation: " + jsString(s.EbayEffective.Location) +
		"}"
}

// SettingsPanel is a fragment so a save re-renders it with the NORMALISED value,
// rather than leaving whatever was typed in the box.
templ SettingsPanel(s SettingsView) {
	<div id="settings-panel" class="stack">
		<div class="card" style="max-width:640px">
			<div class="card-head"><h2>Public address</h2></div>
			<div class="card-body stack">
				<p class="muted">
					The domain this warehouse is reachable at from the internet. Shopify
					and eBay fetch photographs from their own servers, so every image
					address in an export is built by appending to this.
				</p>
				if s.Note != "" {
					@Message("ok", s.Note)
				}
				<div>
					<span class="tile-label">In use now</span>
					<div class="tile-value" style="font-size:18px">
						<code class="code">{ s.Current }</code>
					</div>
					<span class="hint">{ s.Source() }</span>
				</div>
				if !s.Reachable {
					@Message("error", "A marketplace cannot fetch photographs from "+s.Current+" — it only resolves on this machine. Exports will produce listings with no pictures, and no marketplace reports that as an error. Set the domain this warehouse is published at.")
				}
				<div class="field">
					<label for="pub-base">Domain</label>
					<input
						id="pub-base"
						class="input"
						type="url"
						inputmode="url"
						autocomplete="url"
						spellcheck="false"
						placeholder="https://warehouse.example.com"
						data-bind:set-public-base
						data-on:keydown="evt.key === 'Enter' && @post('/settings')"
					/>
					<span class="hint">
						Just the origin — scheme and host, no path. A trailing slash is
						removed for you.
					</span>
				</div>
				<div>
					<button
						class="btn btn-primary"
						type="button"
						data-on:click="@post('/settings')"
						data-indicator:_busy
						data-attr:disabled="$_busy"
					>
						<span data-show="$_busy" style="display:none" class="spinner" aria-hidden="true"></span>
						<span>Save address</span>
					</button>
				</div>
				if s.Stored != "" {
					<span class="faint">
						Saved { s.UpdatedAt.Format("2 Jan 2006 15:04") } UTC. The start-up
						default was <code class="code">{ s.FromEnvironment }</code>.
					</span>
				} else {
					<span class="faint">
						Nothing saved yet, so the start-up default is in use. Setting it
						here takes effect immediately and survives a restart.
					</span>
				}
			</div>
		</div>
		<!--
		  ADR-016. Until this card existed the eBay category could only be
		  supplied through EBAY_CATEGORY, read once at start-up, documented in no
		  table in the README — so the export refused with "a category id is
		  required" and nothing anywhere said where to put one.

		  There is no <form> here: ADR-008 permits exactly one, the photo upload.
		  The inputs bind to signals and the button posts them.
		-->
		<div class="card" style="max-width:640px">
			<div class="card-head"><h2>eBay</h2></div>
			<div class="card-body stack">
				<p class="muted">
					What eBay needs beyond the item itself. A category number is
					required on every listing — these are eBay's own taxonomy, so
					there is no sensible default — and an individual offer can
					override this one on its own page.
				</p>
				<div class="field">
					<label for="ebay-category">Default category</label>
					<input
						id="ebay-category"
						class="input"
						type="text"
						inputmode="numeric"
						spellcheck="false"
						placeholder="11450"
						data-bind:set-ebay-category
						data-on:keydown="evt.key === 'Enter' &amp;&amp; @post('/settings')"
					/>
					<span class="hint">
						Used for any offer that does not name its own. Find the number
						on eBay under Sell → category lookup.
					</span>
				</div>
				<div class="field">
					<label for="ebay-condition">Condition code</label>
					<input
						id="ebay-condition"
						class="input"
						type="text"
						inputmode="numeric"
						spellcheck="false"
						placeholder="3000"
						data-bind:set-ebay-condition
						data-on:keydown="evt.key === 'Enter' &amp;&amp; @post('/settings')"
					/>
					<span class="hint">3000 is "Used", which is what most second-hand stock is.</span>
				</div>
				<div class="field">
					<label for="ebay-location">Item location</label>
					<input
						id="ebay-location"
						class="input"
						type="text"
						spellcheck="false"
						placeholder="Kaunas, Lithuania"
						data-bind:set-ebay-location
						data-on:keydown="evt.key === 'Enter' &amp;&amp; @post('/settings')"
					/>
					<span class="hint">
						Shown on every listing, and eBay uses it to quote postage.
					</span>
				</div>
				<div>
					<button
						class="btn btn-primary"
						type="button"
						data-on:click="@post('/settings')"
						data-indicator:_busy
						data-attr:disabled="$_busy"
					>
						<span data-show="$_busy" style="display:none" class="spinner" aria-hidden="true"></span>
						<span>Save eBay settings</span>
					</button>
				</div>
				if s.EbayFromEnv.Category != "" {
					<span class="faint">
						The start-up default for the category was
						<code class="code">{ s.EbayFromEnv.Category }</code>.
					</span>
				} else {
					<span class="faint">
						No start-up default was configured, so until something is saved
						here every eBay export refuses.
					</span>
				}
			</div>
		</div>
	</div>
}
