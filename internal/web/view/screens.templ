package view

import "github.com/atvirokodosprendimai/app-warehousev1/internal/core"

// IntakeScreen is the front of the flow: photograph, title, shelve. Deliberately
// NOT a price. The price is researched later, and asking for it here is what
// makes an operator type a placeholder that later ships to a marketplace.
templ IntakeScreen(locations []core.Location) {
	<div class="stack" data-signals="{newTitle: '', newSku: '', newLocation: ''}">
		<div id="intake-msg"></div>
		<div class="card" style="max-width:640px">
			<div class="card-head"><h2>New offer</h2></div>
			<div class="card-body stack">
				<div class="field">
					<label for="n-title">What is it?</label>
					<input
						id="n-title"
						class="input"
						type="text"
						placeholder="Vintage brass desk lamp"
						autofocus
						data-bind:new-title
						data-on:keydown="evt.key === 'Enter' && @post('/offers')"
					/>
					<!--
					  Deliberately NOT required (ADR-019). Somebody photographing a shelf is
					  often holding a thing they cannot identify, and demanding a name first
					  is what produces "lamp 2" — a placeholder that, unlike a placeholder
					  PRICE, no constraint would ever stop reaching a marketplace.
					-->
					<span class="hint">
						Optional. Leave it blank if you are only photographing — the item goes to
						<strong>Needs describing</strong> so somebody can name and describe it later.
					</span>
				</div>
				<div class="field">
					<label for="n-sku">Reference</label>
					<input id="n-sku" class="input" type="text" placeholder="left blank — generated" data-bind:new-sku/>
					<span class="hint">
						Used as the Shopify handle and the eBay custom label. Leave it
						blank and one is generated; once published it should not change.
					</span>
				</div>
				<div class="field">
					<label for="n-loc">Where did you put it?</label>
					<select id="n-loc" class="select" data-bind:new-location>
						<option value="">Decide later</option>
						for _, l := range locations {
							<option value={ l.ID }>{ l.Path }</option>
						}
					</select>
				</div>
				<div>
					<button
						class="btn btn-primary"
						type="button"
						data-on:click="@post('/offers')"
						data-indicator:_busy
						data-attr:disabled="$_busy"
					>
						<span data-show="$_busy" style="display:none" class="spinner" aria-hidden="true"></span>
						<span>Create and add photos</span>
					</button>
				</div>
			</div>
		</div>
	</div>
}

// WarehouseScreen renders the storage tree.
//
// The tree is rendered flat and indented rather than as nested lists, because
// the operator's question is "where is everything" — a flat, path-ordered list
// answers that at a glance and stays readable when the tree is one site deep.
templ WarehouseScreen(t LocationTree) {
	<div class="stack">
		<div class="card">
			<div class="card-head">
				<h2>Storage</h2>
				<span class="spacer"></span>
				@AddPlaceAction("")
			</div>
			if len(t.Nodes) == 0 {
				@Empty("🏬", "No storage defined yet", "Start with a site — a building, a garage, a room in another city. You can add shelves and bins inside it later, without moving any stock.") {
					<a class="btn btn-primary" href="/warehouse/new">Add the first site</a>
				}
			} else {
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th scope="col">Place</th>
								<th scope="col">Kind</th>
								<th scope="col">Held by</th>
								<th scope="col">City</th>
								<th scope="col" class="num">Items</th>
								<th scope="col"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody>
							for _, n := range t.Nodes {
								<tr>
									<td style={ n.Indent() }>
										<a class="row-title code" href={ templ.SafeURL("/warehouse/" + n.Location.ID) }>{ n.Location.Code }</a>
										if n.Location.Label != "" {
											<div class="row-sub">{ n.Location.Label }</div>
										}
									</td>
									<td class="muted">{ n.Location.Kind.Label() }</td>
									<td>
										if n.Where.Offsite() {
											<span>{ n.Where.Custodian }</span>
											if n.Where.CustodianContact != "" {
												<div class="row-sub faint">{ n.Where.CustodianContact }</div>
											}
										} else {
											<span class="faint">You</span>
										}
									</td>
									<td class="muted">{ orDash(n.Where.City) }</td>
									<td class="num">
										<a href={ templ.SafeURL("/offers?at=" + n.Location.Path) }>{ itoa(n.Stock) }</a>
									</td>
									<td>
										<!--
										  "Add" carries the row's own id, so the form opens
										  already knowing where you are adding to. Without it
										  the operator has to find, in a select box, the very
										  place they just clicked beside.
										-->
										<a
											class="btn btn-ghost"
											href={ templ.SafeURL("/warehouse/new?parent=" + n.Location.ID) }
											aria-label={ "Add a place inside " + n.Location.Path }
										>Add inside</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}

// AddPlaceAction is the top-bar button for adding storage. When parentID is set
// the form opens with that place already chosen.
templ AddPlaceAction(parentID string) {
	if parentID == "" {
		<a class="btn" href="/warehouse/new">Add a place</a>
	} else {
		<a class="btn" href={ templ.SafeURL("/warehouse/new?parent=" + parentID) }>Add a place</a>
	}
}

// NewLocationScreen adds a node to the storage tree.
//
// preset is the enclosing place chosen on the previous screen; empty means the
// operator is adding a new site.
templ NewLocationScreen(parents []core.Location, preset string) {
	<div class="stack" data-signals={ newLocationSignals(preset) }>
		<div id="loc-msg"></div>
		<div class="card" style="max-width:640px">
			<div class="card-head"><h2>Add a place</h2></div>
			<div class="card-body stack">
				<div class="grid-2">
					<div class="field">
						<label for="l-parent">Inside</label>
						<select id="l-parent" class="select" data-bind:loc-parent>
							<option value="">Nothing — this is a site</option>
							for _, p := range parents {
								<option value={ p.ID }>{ p.Path }</option>
							}
						</select>
					</div>
					<div class="field">
						<label for="l-kind">Kind</label>
						<select id="l-kind" class="select" data-bind:loc-kind>
							for _, k := range core.Kinds() {
								<option value={ string(k) }>{ k.Label() }</option>
							}
						</select>
						<span class="hint">Levels are optional — a site may hold bins directly.</span>
					</div>
				</div>
				<div class="grid-2">
					<div class="field">
						<label for="l-code">Code</label>
						<input id="l-code" class="input" type="text" placeholder="A000005" autofocus data-bind:loc-code/>
						<span class="hint">What is written on the shelf. No slashes.</span>
					</div>
					<div class="field">
						<label for="l-label">Description</label>
						<input id="l-label" class="input" type="text" placeholder="under the window" data-bind:loc-label/>
					</div>
				</div>
				<div class="grid-2">
					<div class="field">
						<label for="l-city">City</label>
						<input id="l-city" class="input" type="text" placeholder="Kaunas" data-bind:loc-city/>
						<span class="hint">Required on a site. Inherited by everything inside it.</span>
					</div>
					<div class="field">
						<label for="l-country">Country</label>
						<input id="l-country" class="input" type="text" placeholder="LT" data-bind:loc-country/>
					</div>
				</div>
				<div class="grid-2">
					<div class="field">
						<label for="l-cust">Held by</label>
						<input id="l-cust" class="input" type="text" placeholder="leave blank if it is yours" data-bind:loc-custodian/>
						<span class="hint">Whoever physically has the stock, if it is not you.</span>
					</div>
					<div class="field">
						<label for="l-contact">Their contact</label>
						<input id="l-contact" class="input" type="text" placeholder="phone or email" data-bind:loc-contact/>
						<span class="hint">Storage you cannot reach is storage you cannot sell from.</span>
					</div>
				</div>
				<div>
					<button
						class="btn btn-primary"
						type="button"
						data-on:click="@post('/warehouse')"
						data-indicator:_busy
						data-attr:disabled="$_busy"
					>
						<span data-show="$_busy" style="display:none" class="spinner" aria-hidden="true"></span>
						<span>Add place</span>
					</button>
				</div>
			</div>
		</div>
	</div>
}

// newLocationSignals seeds the add-a-place form.
//
// When a parent was chosen the default KIND changes too, from "site" to "shelf".
// A site is a root and cannot sit inside anything, so leaving the default at
// "site" beside a preselected parent would offer a combination the domain
// refuses — a form whose default state is invalid.
func newLocationSignals(preset string) string {
	kind := "site"
	if preset != "" {
		kind = "shelf"
	}
	return "{locParent: " + jsString(preset) + ", locKind: " + jsString(kind) +
		", locCode: '', locLabel: '', locCustodian: '', locContact: '', locCity: '', locCountry: ''}"
}

// ExportScreen builds a marketplace CSV, either of everything sellable or of one
// saved batch.
templ ExportScreen(profiles []ExportProfile, base string, absolute bool, carts []core.Cart, ready int, held []core.Offer) {
	<div class="stack">
		if !absolute {
			@Message("error", "PUBLIC_BASE_URL is not an absolute http(s) URL, so photo links in an export would not resolve. A marketplace fetches images from its own servers and reports no error when they fail — fix this before exporting.")
		}
		<div class="card" style="max-width:720px">
			<div class="card-head">
				<h2>Export everything sellable</h2>
				<span class="spacer"></span>
				<span class="faint">{ itoa(ready) } ready</span>
			</div>
			<div class="card-body stack">
				<p class="muted">
					Only offers that are listed or pending are exported. Drafts and
					archived items are left out, and the owner's price is never included.
				</p>
				<span class="hint">Photo links will be built from <code class="code">{ base }</code></span>
				if ready == 0 {
					@Message("info", "Nothing is ready to export yet. Anything being held back is listed below, with what it is waiting for.")
				} else {
					<div class="toolbar">
						for _, p := range profiles {
							if p.Ready {
								<a class="btn btn-primary" href={ templ.SafeURL("/export/" + p.Name + ".csv") } download>
									Download { p.Name } CSV
								</a>
							}
						}
					</div>
					for _, p := range profiles {
						if !p.Ready {
							@Message("info", p.Name+" is not configured: "+p.Problem)
						}
					}
					<div>
					</div>
				}
			</div>
		</div>
		if len(held) > 0 {
			<div class="card" style="max-width:720px">
				<div class="card-head">
					<h2>Not being sent</h2>
					<span class="spacer"></span>
					<span class="faint">{ itoa(len(held)) }</span>
				</div>
				<div class="card-body">
					@Message("info", "These are listed or pending but an export cannot render them. They are shown here rather than discovered as a failed download.")
				</div>
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th scope="col">Item</th>
								<th scope="col">Waiting for</th>
							</tr>
						</thead>
						<tbody>
							for _, o := range held {
								<tr>
									<td>
										<a class="row-title" href={ templ.SafeURL("/offers/" + o.ID) }>{ o.Title }</a>
										<div class="row-sub code">{ o.SKU }</div>
									</td>
									<td><span class="flag-nopricing">{ core.HoldReason(o) }</span></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
		<div class="card" style="max-width:720px">
			<div class="card-head">
				<h2>Export a saved batch</h2>
				<span class="spacer"></span>
				<a class="btn btn-ghost" href="/carts">Manage batches</a>
			</div>
			if len(carts) == 0 {
				@Empty("🧺", "No saved batches", "A batch is a selection you build up over time and then send as one file. Unlike a filter, its contents do not change underneath you.") {
					<a class="btn btn-primary" href="/carts">Create one</a>
				}
			} else {
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th scope="col">Batch</th>
								<th scope="col" class="num">Items</th>
								<th scope="col">Download</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range carts {
								<tr>
									<td>
										<a class="row-title" href={ templ.SafeURL("/carts/" + c.ID) }>{ c.Name }</a>
										if c.Note != "" {
											<div class="row-sub">{ c.Note }</div>
										}
									</td>
									<td class="num">{ itoa(c.Size()) }</td>
									<td>
										<div class="toolbar">
											for _, p := range profiles {
												if p.Ready {
													<a class="btn btn-ghost" href={ templ.SafeURL("/export/" + p.Name + ".csv?cart=" + c.ID) } download>{ p.Name }</a>
												}
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}

// UsersScreen is account management. Reachable only by an administrator; there
// is no public registration anywhere in this product.
templ UsersScreen(u Users) {
	<div class="stack" data-signals="{userEmail: '', userName: '', userPassword: '', userAdmin: false}">
		<div id="users-msg"></div>
		<div class="card">
			<div class="card-head"><h2>Accounts</h2></div>
			@UserTable(u.Users)
		</div>
		<div class="card" style="max-width:560px">
			<div class="card-head"><h2>Add an account</h2></div>
			<div class="card-body stack">
				<div class="field">
					<label for="u-name">Name</label>
					<input id="u-name" class="input" type="text" data-bind:user-name/>
				</div>
				<div class="field">
					<label for="u-email">Email</label>
					<input id="u-email" class="input" type="email" data-bind:user-email/>
				</div>
				<div class="field">
					<label for="u-pass">Initial password</label>
					<input id="u-pass" class="input" type="text" data-bind:user-password/>
					<span class="hint">
						At least 10 characters. Give it to them directly — there is no
						reset email, by design.
					</span>
				</div>
				<div class="field">
					<label for="u-admin">
						<input id="u-admin" type="checkbox" data-bind:user-admin/>
						Administrator
					</label>
				</div>
				<div>
					<button
						class="btn btn-primary"
						type="button"
						data-on:click="@post('/users')"
						data-indicator:_busy
						data-attr:disabled="$_busy"
					>
						<span data-show="$_busy" style="display:none" class="spinner" aria-hidden="true"></span>
						<span>Create account</span>
					</button>
				</div>
			</div>
		</div>
	</div>
}

// orDash renders a value or an em dash when it is empty.
func orDash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}
