package view

import "github.com/atvirokodosprendimai/app-warehousev1/internal/core"

// OfferScreen is the single-offer editor.
//
// It opens ONE SSE connection for the whole page (data-init on the wrapper), and
// the server decides what to push down it. Per-widget streams would multiply
// connections for no gain — the server already knows which fragments changed.
//
// Signals are declared here rather than in the layout, because signals are
// global and flattened and every unprefixed one rides to the backend on every
// action. Keeping them on the screen that uses them means the dashboard does not
// pay for the editor's state. They are feature-prefixed for the same reason:
// there is no component scope to protect them.
templ OfferScreen(d OfferDetail) {
	<div
		class="stack"
		data-signals={ offerSignals(d) }
	>
		<div id="offer-flash"></div>
		<!--
		  Card order IS the flow, and on a phone it is the only thing that decides
		  what you meet first: .cols is one column below 861px, so the page becomes
		  these two stacks read end to end.

		  M set this order directly (ADR-020): "1step click offer, 2nd upload
		  photos 3rd - all other info", then "status: listing, draf, pending etc.
		  should be last block".

		  So PHOTOGRAPHS COME FIRST. Pressing New offer creates the draft and lands
		  here, and the operator is still holding the object — the camera is the
		  only thing they need in that moment. Details follows, because describing
		  and photographing are one task. Pricing follows those, since ADR-004
		  makes the price a later, researched step.

		  STATUS IS LAST, and it is the only card here that is not data entry:
		  every other card records what the thing IS, while this one decides what
		  the business does with it. It used to head the second column, which on a
		  phone put "Listed / Draft / Pending" between the photographs and the price.
		-->
		<div class="cols">
			<div class="stack">
				@OfferPhotosCard(d)
				@offerDetailsCard(d)
				@OfferFieldsCard(d)
				@offerPricingCard(d)
			</div>
			<div class="stack">
				@offerLocationCard(d)
				@OfferCartsCard(d)
				@offerMarketplaceCard(d)
				@OfferStatusCard(d)
			</div>
		</div>
	</div>
}

// offerSignals builds the page's initial signal object.
//
// camelCase inside the object literal, kebab-case in the data-bind attribute
// suffix — they are the same signal. HTML lowercases attribute names, so writing
// data-bind:shopAmount would bind "shopamount" and silently miss this literal.
func offerSignals(d OfferDetail) string {
	o := d.Row.Offer
	return "{" +
		"offerTitle: " + jsString(o.Title) + ", " +
		"offerDescription: " + jsString(o.Description) + ", " +
		"offerCondition: " + jsString(o.Condition) + ", " +
		"shopAmount: " + jsString(decimalOrEmpty(o.Shop)) + ", " +
		"shopCurrency: " + jsString(currencyOr(o.Shop, core.BaseCurrency)) + ", " +
		"ownerAmount: " + jsString(decimalOrEmpty(o.Owner)) + ", " +
		"ownerCurrency: " + jsString(currencyOr(o.Owner, core.BaseCurrency)) + ", " +
		"offerLocation: " + jsString(o.LocationID) + ", " +
		"offerSku: " + jsString(o.SKU) + ", " +
		"offerQuantity: " + jsString(itoa(o.Quantity)) + ", " +
		"offerEbayCategory: " + jsString(o.Categories["ebay"]) + ", " +
		"offerCategory: " + jsString(o.CategoryID) +
		fieldSignalSeed(d) +
		"}"
}

// fieldSignalSeed adds one signal per custom field the offer's category asks.
//
// ⚠ A BOOL IS SEEDED AS A JS BOOLEAN, NOT A STRING. A checkbox bound to the
// string "" is checked, because "" is a value datastar happily assigns and the
// DOM coerces; seeding false is what makes an unanswered yes/no render as
// unanswered. Every other kind is a string, which is what every other signal on
// this screen is.
func fieldSignalSeed(d OfferDetail) string {
	out := ""
	for _, f := range d.Fields {
		out += ", " + FieldSignal(f.ID) + ": "
		if f.Kind == core.FieldBool {
			if f.Bool() {
				out += "true"
			} else {
				out += "false"
			}
			continue
		}
		out += jsString(f.Value)
	}
	return out
}

// FieldSignalValues is the same seed as fieldSignalSeed, keyed by signal name so
// it can be sent over SSE rather than written into the page.
//
// It exists because the questions card can APPEAR after the page has loaded: an
// offer filed under a category mid-session gets controls whose signals were
// never seeded, and an input bound to a signal that does not exist renders blank
// however right its markup is. The stream sends these if-missing, which seeds a
// card that has just arrived without overwriting what somebody is typing into
// one that was already there.
//
// ⚠ IT MUST AGREE WITH fieldSignalSeed ON THE BOOL RULE — a yes/no is a real
// boolean by both routes, never a string — and TestTheTwoSignalSeedsAgree fails
// if the two ever drift apart.
func FieldSignalValues(d OfferDetail) map[string]any {
	out := make(map[string]any, len(d.Fields))
	for _, f := range d.Fields {
		if f.Kind == core.FieldBool {
			out[FieldSignal(f.ID)] = f.Bool()
			continue
		}
		out[FieldSignal(f.ID)] = f.Value
	}
	return out
}

// OfferFieldsCard asks whatever this offer's category asks.
//
// ⚠ IT KNOWS NO FIELD NAMES. Everything here comes from the resolved list the
// handler loaded, which is the point of ADR-021: the operator defines the
// questions and this card renders them. A template that named a field would be
// a schema per trade, shipped by us, which is the thing the record exists to
// avoid.
//
// The card sits after Photographs and before Status on purpose. ADR-020 put the
// camera first and the publish decision last, and this is neither — it is
// description, so it belongs beside Details.
//
// ⚠ THE WRAPPER IS ALWAYS RENDERED; THE CARD INSIDE IT IS NOT. Filing an offer
// under a category is what brings these questions into existence, so the card
// has to be able to APPEAR on a page that was loaded without one — and an SSE
// patch can only replace an element that is already in the document. An offer
// with no category therefore renders an empty <div id="offer-fields">: nothing
// to look at, and a target for the stream to write into.
//
// M found this by filing an offer and being asked nothing. Every Go test passed,
// smoke passed and the browser walk passed, because the walk reloaded the page
// immediately after saving — which is the one step an operator does not take.
templ OfferFieldsCard(d OfferDetail) {
	<div id="offer-fields">
		if len(d.Fields) > 0 {
			<div class="card">
				<div class="card-head">
					<h2>Details for this category</h2>
				</div>
				<div class="card-body stack">
					for _, g := range d.FieldsByLevel() {
						<div class="field-group">
							<!--
							  The level a question came from, shown because an operator who
							  did not define it here should be able to see WHY they are being
							  asked and where to go to change it.
							-->
							<h3 class="field-group-head">{ g.Leaf() }</h3>
							for _, f := range g.Fields {
								@offerField(f)
							}
						</div>
					}
					<div>
						<button
							class="btn btn-primary"
							type="button"
							data-on:click={ "@post('/offers/" + d.Row.Offer.ID + "/fields')" }
							data-indicator:_busy
							data-attr:disabled="$_busy"
						>
							<span data-show="$_busy" style="display:none" class="spinner" aria-hidden="true"></span>
							<span>Save these details</span>
						</button>
					</div>
				</div>
			</div>
		}
	</div>
}

// offerField renders one question's control.
//
// ⚠ THE DEFAULT BRANCH IS LOAD-BEARING, NOT TIDINESS. A kind this binary does
// not recognise renders as a text input rather than failing the page: a row
// written by a newer version and read by an older one should degrade to
// something an operator can still read and type into. ADR-021 records this as a
// Risk and this is where it is answered. Writing an unknown kind is refused
// separately, by core.ParseFieldKind, which is what keeps the case rare.
templ offerField(f core.OfferField) {
	<div class="field">
		<label for={ "cf-" + f.ID }>
			{ f.Label }
			if f.Required {
				<span class="hint-inline">— usually needed</span>
			}
		</label>
		switch f.Kind {
			case core.FieldLongText:
				<textarea id={ "cf-" + f.ID } class="textarea" { FieldBind(f)... }></textarea>
			case core.FieldNumber:
				<div class="row-inline">
					<input id={ "cf-" + f.ID } class="input" type="text" inputmode="numeric" { FieldBind(f)... }/>
					if f.Unit != "" {
						<span class="unit">{ f.Unit }</span>
					}
				</div>
			case core.FieldChoice:
				<select id={ "cf-" + f.ID } class="select" { FieldBind(f)... }>
					<option value="">— not set —</option>
					for _, opt := range f.OptionList() {
						<option value={ opt }>{ opt }</option>
					}
				</select>
			case core.FieldBool:
				<input id={ "cf-" + f.ID } type="checkbox" { FieldBind(f)... }/>
			default:
				<input id={ "cf-" + f.ID } class="input" type="text" { FieldBind(f)... }/>
		}
	</div>
}

templ offerDetailsCard(d OfferDetail) {
	<div class="card">
		<div class="card-head">
			<h2>Details</h2>
		</div>
		<div class="card-body stack">
			<div class="field">
				<label for="o-title">Title</label>
				<input id="o-title" class="input" type="text" data-bind:offer-title/>
				<span class="hint">This is the listing headline on every marketplace.</span>
			</div>
			<div class="field">
				<label for="o-desc">Description</label>
				<textarea id="o-desc" class="textarea" data-bind:offer-description></textarea>
			</div>
			<div class="field">
				<label for="o-cond">Condition</label>
				<input id="o-cond" class="input" type="text" placeholder="used — good" data-bind:offer-condition/>
			</div>
			<!--
			  WHAT THE THING IS (ADR-021) — the operator's own taxonomy, not a
			  marketplace's. ⚠ The eBay category is a DIFFERENT field on a
			  DIFFERENT card: that one says where to list this, and it comes from
			  eBay's taxonomy. This one says what it is, and it decides which
			  questions the card below asks.

			  Optional, and it stays optional: ADR-004 and ADR-019 both exist
			  because demanding a value at the shelf is what makes somebody type a
			  placeholder.
			-->
			<div class="field">
				<label for="o-category">Category</label>
				<!--
				  No `selected` attribute, matching the location picker above: the
				  value comes from the seeded signal through data-bind, and a
				  `selected` attribute beside it would be a second source of truth
				  that disagrees the moment the signal changes.
				-->
				<!--
				  IT APPLIES ON CHANGE, unlike every other control in this card.
				  Choosing a category is not describing the thing — it decides which
				  questions the page asks next, and those arrive from the server over
				  the stream. Waiting for Save details would mean choosing a category
				  and being shown nothing, which is exactly what M reported.
				-->
				<select
					id="o-category"
					class="select"
					data-bind:offer-category
					data-on:change={ "@post('/offers/" + d.Row.Offer.ID + "')" }
				>
					<option value="">— not filed —</option>
					for _, c := range d.Categories {
						<option value={ c.ID }>{ c.Path } · { c.Name }</option>
					}
				</select>
				<span class="hint">
					What kind of thing this is. Filing it here is what decides which
					extra details you are asked for; the marketplace category is set
					separately, under Marketplace.
				</span>
			</div>
			<!--
			  How many of the thing we hold. The column has existed since the first
			  migration and both exporters have always written it, but nothing in the
			  interface ever SET it — so every offer carried the database default of
			  1, and a shelf of five went to a marketplace as one.

			  Text with an inputmode rather than type="number", matching the prices:
			  a number input sends a JSON number, and every signal this screen reads
			  is a string.
			-->
			<div class="field">
				<label for="o-qty">Qty</label>
				<input id="o-qty" class="input" type="text" inputmode="numeric" data-bind:offer-quantity/>
				<span class="hint">
					How many of this we hold. It is sent to every marketplace as the
					stock figure, so 0 reads as out of stock rather than as unknown.
				</span>
			</div>
			<!--
			  The reference lives here since ADR-020, because deleting the intake
			  screen took away the only place it could be typed. It is allocated by
			  the database (ADR-010) and shown rather than asked for, but it stays
			  EDITABLE: somebody re-cataloguing existing stock has references already
			  written on the boxes, and a typo made at intake used to be permanent.
			-->
			<div class="field">
				<label for="o-sku">Reference</label>
				<input id="o-sku" class="input code" type="text" data-bind:offer-sku/>
				<span class="hint">
					Generated for you, and used as the Shopify handle and the eBay custom
					label. Once the offer is published it should not change.
				</span>
			</div>
			<div>
				<button
					class="btn btn-primary"
					type="button"
					data-on:click={ "@post('/offers/" + d.Row.Offer.ID + "')" }
					data-indicator:_busy
					data-attr:disabled="$_busy"
				>
					<span data-show="$_busy" style="display:none" class="spinner" aria-hidden="true"></span>
					<span>Save details</span>
				</button>
			</div>
		</div>
	</div>
}

// offerPricingCard is the research step made concrete: the price is set here,
// after intake, and the owner's figure sits beside it so the margin is visible
// at the moment the decision is made.
templ offerPricingCard(d OfferDetail) {
	<div class="card">
		<div class="card-head"><h2>Pricing</h2></div>
		<div class="card-body stack">
			<div class="field">
				<label for="shop-amt">Shop price</label>
				<div class="money-row">
					<input id="shop-amt" class="input" type="text" inputmode="decimal" placeholder="0.00" data-bind:shop-amount/>
					<select class="select" aria-label="Shop price currency" data-bind:shop-currency>
						for _, c := range d.Currencies {
							<option value={ c }>{ c }</option>
						}
					</select>
				</div>
				<span class="hint">Published to Shopify and eBay. This is the only price that leaves the building.</span>
			</div>
			<div class="field">
				<label for="own-amt">Owner wants</label>
				<div class="money-row">
					<input id="own-amt" class="input" type="text" inputmode="decimal" placeholder="0.00" data-bind:owner-amount/>
					<select class="select" aria-label="Owner price currency" data-bind:owner-currency>
						for _, c := range d.Currencies {
							<option value={ c }>{ c }</option>
						}
					</select>
				</div>
				<span class="hint">What the holder is to be paid. Never exported.</span>
			</div>
			@MarginLine(d.Row)
			<div>
				<button
					class="btn btn-primary"
					type="button"
					data-on:click={ "@post('/offers/" + d.Row.Offer.ID + "/prices')" }
					data-indicator:_busy
					data-attr:disabled="$_busy"
				>
					<span data-show="$_busy" style="display:none" class="spinner" aria-hidden="true"></span>
					<span>Save prices</span>
				</button>
			</div>
		</div>
	</div>
}

// MarginLine is its own fragment so the server can re-render just this line
// after a price change, rather than the whole card.
templ MarginLine(r OfferRow) {
	<div id="offer-margin">
		if r.Offer.Shop.IsZero() {
			@Message("info", "No shop price yet. This offer is in the pricing queue.")
		} else if r.MarginText() == "—" {
			@Message("error", "The shop price and the owner price are in different currencies, so the margin cannot be shown. Convert one of them first.")
		} else {
			@Message("ok", "Margin "+r.MarginText()+" on a shop price of "+r.PriceText()+".")
		}
	</div>
}

// OfferStatusCard is a fragment as well as part of the page: a status change
// re-renders exactly this card over SSE.
templ OfferStatusCard(d OfferDetail) {
	<div class="card" id="offer-status">
		<div class="card-head">
			<h2>Status</h2>
			<span class="spacer"></span>
			@Badge(d.Row.Offer.Status)
		</div>
		<div class="card-body stack">
			if d.Row.Offer.Status == core.StatusSold {
				<div class="stack">
					<div>
						<span class="tile-label">Sold for</span>
						<div class="tile-value">{ moneyOrDash(d.Row.Offer.Sold) }</div>
					</div>
					if d.Row.Offer.SoldAt != nil {
						<span class="faint">on { d.Row.Offer.SoldAt.Format("2 January 2006") }</span>
					}
					if realisedText(d.Row) != "" {
						<span class="muted">Kept after paying the holder: { realisedText(d.Row) }</span>
					}
				</div>
			} else {
				<div class="toolbar">
					for _, s := range core.Statuses() {
						if s != d.Row.Offer.Status && s != core.StatusSold {
							<button
								class="btn"
								type="button"
								data-on:click={ "@post('/offers/" + d.Row.Offer.ID + "/status/" + string(s) + "')" }
								data-indicator:_busy
								data-attr:disabled="$_busy"
							>Mark { s.Label() }</button>
						}
					}
				</div>
				if d.Row.Offer.Shop.IsZero() {
					@Message("info", "Set a shop price before listing. A published status needs a published price.")
				}
				<div>
					<button
						class="btn btn-primary"
						type="button"
						data-on:click={ "@get('/offers/" + d.Row.Offer.ID + "/sold-dialog')" }
					>Record a sale</button>
				</div>
			}
		</div>
	</div>
}

// realisedText renders what was kept on a completed sale, or "" if unavailable.
func realisedText(r OfferRow) string {
	m, err := r.Offer.Realised()
	if err != nil {
		return ""
	}
	return m.String()
}

// OfferPhotosCard is a fragment: adding or removing a photo re-renders it whole.
//
// ⚠ The file input is the ONE place this app uses form encoding. Bytes cannot
// ride in a signal, so the upload posts with contentType 'form'; everything else
// on the page stays signal-bound.
templ OfferPhotosCard(d OfferDetail) {
	<div class="card" id="offer-photos">
		<div class="card-head">
			<h2>Photos</h2>
			<span class="spacer"></span>
			<span class="faint">{ itoa(len(d.Row.Offer.Photos)) }</span>
		</div>
		<div class="card-body stack">
			<div class="photos">
				for i, p := range d.Row.Offer.Photos {
					<figure class="photo">
						<!--
						  The thumbnail is a LINK to the stored original, not a
						  decoration. object-fit:cover crops it to a square, so the strip
						  can never show the whole photograph — and on a phone there was
						  otherwise no way to see the rest of it, let alone magnify it.
						  Opening the file hands the job to the browser's own image
						  viewer, which already does pinch-zoom, double-tap and save,
						  and needs no code from us to be right on every device.

						  target=_blank is load-bearing rather than habit: this page
						  keeps unsaved edits (title, description, prices) in datastar
						  signals, so navigating away in the same tab would silently
						  discard whatever the operator had typed.
						-->
						<a
							class="photo-view"
							href={ templ.SafeURL(p.PublicPath()) }
							target="_blank"
							rel="noopener"
							aria-label={ "Open " + photoAlt(d.Row.Offer.Title, i) + " at full size" }
						>
							<img src={ p.PublicPath() } alt={ photoAlt(d.Row.Offer.Title, i) } loading="lazy" width="104" height="104"/>
							if i == 0 {
								<span class="photo-primary">MAIN</span>
							}
						</a>
						<!--
						  Remove sits BELOW the image rather than over it. At 24px in the
						  corner of a 104px tile it was both under the 44px touch target
						  this application holds itself to and directly in the way of the
						  tap that opens the photo — on a phone that is a destructive
						  action a thumb finds by accident.
						-->
						<button
							class="photo-del"
							type="button"
							aria-label={ "Remove " + photoAlt(d.Row.Offer.Title, i) }
							data-on:click={ "@delete('/photos/" + p.ID + "?offer=" + d.Row.Offer.ID + "')" }
						>Remove</button>
					</figure>
				}
				<!--
				  ⚠ A REAL <form>, and it is the ONE exception to this application's
				  no-form rule. Every attribute on it is load-bearing, and datastar
				  v1.0.2's own source says why:

				    let T = l ? document.querySelector(l) : r.closest("form");
				    if (!T) throw i("FetchFormNotFound", ...);
				    let A = T.getAttribute("enctype") === "multipart/form-data";
				    A || (q["Content-Type"] = "application/x-www-form-urlencoded");
				    let X = new URLSearchParams(F);
				    if (ot(t)) A ? Y.body = F : Y.body = X;

				  So: with no enclosing form it THROWS and never sends the request —
				  the control appears dead rather than failing. Without the enctype it
				  degrades to URLSearchParams, which cannot carry bytes. And FormData
				  collects only NAMED controls, so the input needs `name`. All three
				  were missing here, and each one alone is fatal.

				  There is deliberately NO data-bind on the input: the file rides in
				  the FormData, and binding it would additionally serialise the file's
				  contents into a page-global signal that then ships on every later
				  action.
				-->
				<form enctype="multipart/form-data" data-on:submit="evt.preventDefault()">
					<!--
					  TWO controls, not one, because on a phone "add a photograph" is two
					  different acts. Reported by M on 2026-09-07: the upload "needs to
					  choose if on mobile, want to make few photos or choose from gallery".

					  ⚠ WHY ONE INPUT COULD NOT DO BOTH. A single input's behaviour is
					  decided by `accept` and `capture`, and the operating system — not
					  this markup — decides what sheet to show. `capture` opens the camera
					  and REMOVES the gallery as an option; omitting it leaves the choice
					  to the OS, and an `accept` naming specific MIME types (which this
					  upload has always used, and still does for the gallery) is exactly
					  what makes iOS drop "Take Photo" from that sheet. So the choice M
					  wants cannot be expressed on one input at all. Two inputs make it
					  explicit and stop depending on OS heuristics.
					-->
					<div class="drop-row">
						<!--
						  Camera. `image/*` rather than the explicit list because a capture
						  returns whatever the camera produces and the SERVER is the real
						  gate anyway — internal/web/upload.go sniffs the magic bytes and
						  accepts only jpeg/png/webp/gif, so a browser-side accept is a
						  convenience, never the check.

						  No `multiple`: a capture is one photograph, and every platform
						  ignores `multiple` alongside `capture`. Taking "a few" is tapping
						  this a few times, which is also how a camera app behaves.
						-->
						<label class="drop drop-camera" data-show="!$_uploading">
							<span aria-hidden="true">📷</span>
							<span>Take photo</span>
							<input
								class="sr-only"
								type="file"
								name="photos"
								accept="image/*"
								capture="environment"
								data-on:change={ "@post('/offers/" + d.Row.Offer.ID + "/photos', {contentType: 'form'})" }
								data-indicator:_uploading
								data-attr:disabled="$_uploading"
							/>
						</label>
						<!--
						  Gallery, and the only control on a desktop. Keeps the explicit
						  MIME list it has always had: narrowing the picker to what the
						  server accepts is worth more here than it is for a capture,
						  because this is where somebody can reach a file that is not a
						  photograph at all.
						-->
						<label class="drop drop-gallery" data-show="!$_uploading">
							<span aria-hidden="true">＋</span>
							<span>Choose photos</span>
							<input
								class="sr-only"
								type="file"
								name="photos"
								accept="image/jpeg,image/png,image/webp,image/gif"
								multiple
								data-on:change={ "@post('/offers/" + d.Row.Offer.ID + "/photos', {contentType: 'form'})" }
								data-indicator:_uploading
								data-attr:disabled="$_uploading"
							/>
						</label>
						<!--
						  ADR-015's busy half, now shared. It REPLACES both controls rather
						  than sitting beside them: two spinners for one upload would read
						  as two uploads. `_uploading` is all lowercase ON PURPOSE — the
						  signal name lives in the ATTRIBUTE NAME and HTML lowercases those,
						  so a camelCase name would have datastar create one signal while
						  every line here reads another. It is underscore-prefixed to stay
						  in the browser, and deliberately NOT `_busy`: signals are global,
						  so sharing that name would spin every other control on this page.
						-->
						<div class="drop drop-busy" data-show="$_uploading" style="display:none">
							<span class="spinner" aria-hidden="true"></span>
							<span aria-live="polite">Uploading…</span>
						</div>
					</div>
				</form>
			</div>
			if len(d.Row.Offer.Photos) == 0 {
				@Message("info", "A marketplace listing without photographs will not sell. Add at least one.")
			} else {
				<details>
					<summary class="faint">Public image URLs</summary>
					<div class="stack" style="margin-top:8px">
						for _, p := range d.Row.Offer.Photos {
							<code class="photo-url">{ p.PublicURL(d.PublicBase) }</code>
						}
					</div>
					<p class="hint">
						Shopify and eBay fetch these from their own servers, so they must
						be reachable from the public internet.
					</p>
				</details>
			}
		</div>
	</div>
}

// photoAlt gives every image real alternative text. "Photo" alone tells a screen
// reader nothing it could not infer from the element.
func photoAlt(title string, i int) string {
	if i == 0 {
		return title + " — main photograph"
	}
	return title + " — photograph " + itoa(i+1)
}

templ offerLocationCard(d OfferDetail) {
	<div class="card" id="offer-location">
		<div class="card-head"><h2>Where it lives</h2></div>
		<div class="card-body stack">
			<div class="field">
				<label for="o-loc">Location</label>
				<select id="o-loc" class="select" data-bind:offer-location>
					<option value="">Not shelved</option>
					for _, l := range d.Locations {
						<option value={ l.ID }>{ l.Path }</option>
					}
				</select>
			</div>
			if d.Row.Where.Summary() != "" {
				<span class="muted">{ d.Row.Where.Summary() }</span>
			}
			if d.Row.Where.Offsite() && d.Row.Where.CustodianContact != "" {
				<span class="faint">Contact: { d.Row.Where.CustodianContact }</span>
			}
			<div>
				<button
					class="btn"
					type="button"
					data-on:click={ "@post('/offers/" + d.Row.Offer.ID + "/location')" }
					data-indicator:_busy
					data-attr:disabled="$_busy"
				>Move</button>
			</div>
		</div>
	</div>
}

// SoldDialog is rendered by the backend into the page's empty #modal div.
//
// Nothing about it is pre-rendered and toggled: the browser holds no dialog
// state, so there is no way for the page to think a dialog is open when it is
// not.
templ SoldDialog(d OfferDetail) {
	<div id="modal">
		<div class="modal-scrim" data-on:click="@get('/modal/close')">
			<div
				class="modal"
				role="dialog"
				aria-modal="true"
				aria-labelledby="sold-title"
				data-on:click="evt.stopPropagation()"
				data-signals={ "{soldAmount: '', soldCurrency: " + jsString(currencyOr(d.Row.Offer.Shop, core.BaseCurrency)) + ", soldDate: " + jsString(today()) + "}" }
			>
				<div class="modal-head">
					<h2 id="sold-title">Record a sale</h2>
					<span class="spacer"></span>
					<button class="btn btn-ghost" type="button" aria-label="Close" data-on:click="@get('/modal/close')">×</button>
				</div>
				<div class="modal-body">
					<div id="sold-msg"></div>
					<p class="muted">{ d.Row.Offer.Title }</p>
					<div class="field">
						<label for="sold-amt">Sold for</label>
						<div class="money-row">
							<input id="sold-amt" class="input" type="text" inputmode="decimal" placeholder="0.00" data-bind:sold-amount/>
							<select class="select" aria-label="Sale currency" data-bind:sold-currency>
								for _, c := range d.Currencies {
									<option value={ c }>{ c }</option>
								}
							</select>
						</div>
						<span class="hint">The price actually paid, which may be less than the shop price.</span>
					</div>
					<div class="field">
						<label for="sold-date">Sale date</label>
						<input id="sold-date" class="input" type="date" data-bind:sold-date/>
						<span class="hint">Reports attribute the revenue to this date, and convert at that day's rate.</span>
					</div>
				</div>
				<div class="modal-foot">
					<button class="btn" type="button" data-on:click="@get('/modal/close')">Cancel</button>
					<button
						class="btn btn-primary"
						type="button"
						data-on:click={ "@post('/offers/" + d.Row.Offer.ID + "/sold')" }
						data-indicator:_busy
						data-attr:disabled="$_busy"
					>
						<span data-show="$_busy" style="display:none" class="spinner" aria-hidden="true"></span>
						<span>Record sale</span>
					</button>
				</div>
			</div>
		</div>
	</div>
}

// CloseModal is the empty fragment that removes an open dialog. Sending an empty
// div by id is how the server closes something it opened.
templ CloseModal() {
	<div id="modal"></div>
}

// offerMarketplaceCard carries what a marketplace needs about THIS item rather
// than about the warehouse.
//
// eBay's categories are per item — a lamp and a chair are not the same number —
// so a single value for a whole export file would mean one export per category.
// Leaving this empty is the ordinary case: the offer then uses the default set
// at Settings, and demanding a taxonomy number at intake would block the
// photograph-title-shelve flow ADR-004 protects.
//
// Only eBay appears here because only eBay's resolution is wired; Shopify's and
// Allegro's are deferred in docs/adr/BACKLOG.md.
templ offerMarketplaceCard(d OfferDetail) {
	<div class="card" id="offer-marketplace">
		<div class="card-head"><h2>Marketplace</h2></div>
		<div class="card-body stack">
			<div class="field">
				<label for="o-ebay-cat">eBay category</label>
				<input
					id="o-ebay-cat"
					class="input"
					type="text"
					inputmode="numeric"
					spellcheck="false"
					placeholder="Leave empty to use the default"
					data-bind:offer-ebay-category
					data-on:keydown={ "evt.key === 'Enter' && @post('/offers/" + d.Row.Offer.ID + "/category')" }
				/>
				<span class="hint">
					Only for this item. Empty means the default set at Settings.
				</span>
			</div>
			<div>
				<button
					class="btn"
					type="button"
					data-on:click={ "@post('/offers/" + d.Row.Offer.ID + "/category')" }
					data-indicator:_busy
					data-attr:disabled="$_busy"
				>
					<span data-show="$_busy" style="display:none" class="spinner" aria-hidden="true"></span>
					<span>Save category</span>
				</button>
			</div>
		</div>
	</div>
}
