# app-warehousev1 — example configuration
#
# Copy this file to `.env` and edit it:
#
#     cp .env.example .env
#
# `.env` is gitignored. This example is not: it is the documentation, so keep it
# in step when a variable is added.
#
# ─── How these values are resolved ──────────────────────────────────────────
#
# Lowest priority first:
#
#     built-in default  <  .env  <  real environment variable  <  Settings page
#
# `.env` FILLS GAPS ONLY. A real environment variable always wins, so a one-off
# override works without editing anything:
#
#     EBAY_CATEGORY=1234 ./warehouse
#
# And for the values an administrator can change at **Settings** — the public
# address and the eBay defaults — whatever is stored there beats all of this.
# Those variables are the START-UP DEFAULT: what a fresh installation uses until
# somebody sets them in the application, which takes effect without a restart.
#
# Everything else here is read once at start-up and needs a restart to change.
#
# ─── Syntax ─────────────────────────────────────────────────────────────────
#
#   KEY=value                 # a trailing comment needs a space before the #
#   KEY="quoted value"        # \n \t \" \\ are unescaped inside double quotes
#   KEY='literal value'       # single quotes are taken exactly as written
#   export KEY=value          # accepted, so a line pasted from a shell works
#
# A line that is not blank, a comment, or KEY=VALUE stops the application with
# its line number, rather than booting with a setting silently missing.
#
# ENV_FILE names a different file. It is read from the real environment, because
# a setting that says where the settings are cannot live in the file it names.


# ─── Server ─────────────────────────────────────────────────────────────────

# Listen address. ":8080" listens on every interface; "127.0.0.1:8080" only
# locally, which is what you want while nobody has registered yet — the first
# account to be created becomes the administrator and the page then closes for
# good.
ADDR=:8080

# Mark the session cookie Secure. MUST be true behind HTTPS and false on plain
# HTTP: a Secure cookie is simply not sent over HTTP, so every sign-in would
# appear to fail with no error anywhere.
SECURE_COOKIES=false


# ─── Storage ────────────────────────────────────────────────────────────────

# The SQLite file. Its directory is created if missing.
DB_PATH=data/warehouse.db

# Where photograph bytes live, sharded into subdirectories by id.
PHOTOS_DIR=data/photos


# ─── The public address ─────────────────────────────────────────────────────

# The origin a marketplace fetches photographs from, e.g.
# "https://warehouse.example.com".
#
# ⚠ THIS IS THE SETTING THAT FAILS SILENTLY. Shopify and eBay download images
# from their own servers, so if this is not reachable from the public internet
# the import still succeeds and produces a listing with NO PICTURES — and no
# marketplace reports that as an error.
#
# The default below is absolute and valid and resolves on this machine only, so
# a fresh install is in exactly that state. The export screen warns when the
# address in use is local-only, and an administrator can set the real domain at
# Settings without a restart.
PUBLIC_BASE_URL=http://localhost:8080


# ─── eBay ───────────────────────────────────────────────────────────────────
#
# All three are START-UP DEFAULTS. Set them at Settings → eBay instead to change
# them without a restart; a stored value wins over these, field by field.

# eBay's category number for offers that do not name their own.
#
# There is deliberately no default: the numbers are eBay's own taxonomy and a
# warehouse that sells anything has no defensible one. An individual offer can
# override this on its own page, because a lamp and a chair are not the same
# category — which is what lets mixed stock export in a single file.
#
# Find yours in eBay's category lookup, e.g. 11450 for Clothing.
EBAY_CATEGORY=

# eBay's numeric condition code. 3000 is "Used", which is what most second-hand
# stock is. 1000 is "New", 1500 "Open box", 2500 "Seller refurbished".
EBAY_CONDITION_ID=3000

# The city an item ships from. eBay prints it on every listing and quotes
# postage from it, so an export refuses without one.
EBAY_LOCATION=


# ─── Currency rates ─────────────────────────────────────────────────────────

# Pull the European Central Bank's daily reference rates. Set false in any
# environment with no outbound network access, or the daily refresh logs a
# failure it can never recover from.
FETCH_RATES=true
